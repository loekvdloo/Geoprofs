                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "id": {
                                            "type": "integer",
                                            "example": 1
                                        },
                                        "name": {
                                            "type": "string",
                                            "example": "loek"
                                        },
                                        "email": {
                                            "type": "string",
                                            "example": "loek@loek.nl"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Profile"
                ],
                "summary": "Update user profile (voornaam en email)",
                "operationId": "5c4370b04de069d196077b185063eb82",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "voornaam",
                                    "email"
                                ],
                                "properties": {
                                    "voornaam": {
                                        "type": "string",
                                        "example": "Nieuwe Voornaam"
                                    },
                                    "email": {
                                        "type": "string",
                                        "example": "nieuweemail@voorbeeld.nl"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Profile updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Profiel succesvol bijgewerkt."
                                        },
                                        "user": {
                                            "properties": {
                                                "user_id": {
                                                    "type": "integer",
                                                    "example": 1
                                                },
                                                "voornaam": {
                                                    "type": "string",
                                                    "example": "Nieuwe Voornaam"
                                                },
                                                "achternaam": {
                                                    "type": "string",
                                                    "example": "Test"
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "nieuweemail@voorbeeld.nl"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout the current user (invalidate token)",
                "operationId": "28d48c13fca984400ac8de99f54ee13a",
                "responses": {
                    "200": {
                        "description": "Logged out successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logged out successfully"
                                        }
                                    },

                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "properties": {
                                            "aanvraag_id": {
                                                "type": "integer",
                                                "example": 1
                                            },
                                            "user_id": {
                                                "type": "integer",
                                                "example": 42
                                            },
                                            "medewerker": {
                                                "properties": {
                                                    "id": {
                                                        "type": "integer",
                                                        "example": 42
                                                    },
                                                    "voornaam": {
                                                        "type": "string",
                                                        "example": "Loek"
                                                    },
                                                    "achternaam": {
                                                        "type": "string",

        "/user/password": {
            "put": {
                "tags": [
                    "Profile"
                ],
                "summary": "Update user password (requires current password)",
                "operationId": "e4ff4573a528acae1ea287b21a8531fb",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "example": "oudeWachtwoord123"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "NieuwWachtwoord123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "example": "NieuwWachtwoord123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Password updated successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Wachtwoord succesvol gewijzigd."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Invalid or mismatched passwords",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Huidig wachtwoord is onjuist."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthenticated"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/verlof/beoordeling": {

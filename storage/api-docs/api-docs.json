                                                    },
                                                    "email": {
                                                        "type": "string",
                                                        "example": "loek@loek.nl"
                                                    }
                                                },
                                                "type": "object"
                                            },
                                            "type": {
                                                "properties": {
                                                    "verlof_type_id": {
                                                        "type": "integer",
                                                        "example": 2
                                                    },
                                                    "naam": {
                                                        "type": "string",
                                                        "example": "Ziekteverlof"
                                                    }
                                                },
                                                "type": "object"
                                            },
                                            "start_datum": {
                                                "type": "string",
                                                "format": "date",
                                                "example": "2025-11-10"
